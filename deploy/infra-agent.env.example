# Archivo privado del servicio de agente; chmod 600. No guardar en Git.
FC_INFRA_AGENT_NODO_ID=REEMPLAZAR_UUID
FC_INFRA_AGENT_TOKEN=REEMPLAZAR_TOKEN_GENERADO_EN_SUPERADMIN
FC_INFRA_AGENT_BASE_URL=https://factcentral.online
FC_INFRA_AGENT_ENTORNO=staging
FC_INFRA_AGENT_OPERACIONES=false
FC_INFRA_AGENT_PROJECT=fact-central-agent-staging
FC_INFRA_AGENT_COMPOSE=/opt/factcentral/deploy/docker-compose.agent-staging.yml
FC_INFRA_AGENT_ENV_FILE=/opt/factcentral/deploy/.env.agent-staging
FC_INFRA_AGENT_HEALTH_URL=http://127.0.0.1:18081/health
FC_INFRA_AGENT_STATE_DIR=/var/lib/factcentral-agent
# Debe ser un montaje de almacenamiento externo, con receptor age público configurado.
FC_INFRA_BACKUP_DIR=/mnt/factcentral-backups
FC_INFRA_BACKUP_AGE_RECIPIENT=REEMPLAZAR_RECEPTOR_PUBLICO_AGE
